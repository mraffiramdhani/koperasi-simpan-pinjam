# Secrets untuk Edge Functions.
# Lokal: `supabase functions serve --env-file supabase/functions/.env`
# Cloud: `supabase secrets set --env-file supabase/functions/.env`
#
# Catatan: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# otomatis tersedia di runtime; tidak perlu diisi di sini.

# Xendit: Secret Key (Settings > API Keys, permission Invoices=Write dan
# Disbursements=Write) & Callback Verification Token (Settings > Webhooks).
# Gunakan key mode Test untuk sandbox. Dipakai bersama oleh create-payment/
# payment-webhook (invoice) dan create-disbursement/disbursement-webhook
# (pencairan pinjaman).
XENDIT_SECRET_KEY=xnd_development_xxxxx
XENDIT_CALLBACK_TOKEN=your-callback-verification-token

# FCM (untuk fungsi reminder / push)
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
