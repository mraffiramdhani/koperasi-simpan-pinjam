# ============================================================
# Koperasi Simpan Pinjam POS - Shared Environment Reference
# Salin nilai yang relevan ke web/.env.local dan mobile/.env
# ============================================================

# --- Supabase ---
# Ambil dari `npx supabase start` (lokal) atau dashboard project (cloud)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
# Hanya untuk server-side / Edge Functions. JANGAN taruh di client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Xendit ---
# Daftar di https://dashboard.xendit.co (pakai mode Test untuk sandbox)
# Secret Key: Settings > API Keys (permission Invoices=Write, Disbursements=Write)
# Callback Token: Settings > Webhooks
# Dipakai untuk: create-payment/payment-webhook (invoice) dan
# create-disbursement/disbursement-webhook (pencairan pinjaman)
XENDIT_SECRET_KEY=xnd_development_xxxxx
XENDIT_CALLBACK_TOKEN=your-callback-verification-token

# --- Firebase Cloud Messaging (opsional untuk push) ---
# Service account JSON key untuk kirim push dari Edge Function
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
