# ============================================================
# Koperasi Simpan Pinjam POS - Shared Environment Reference
# Salin nilai yang relevan ke web/.env.local dan mobile/.env
# ============================================================

# --- Supabase ---
# Ambil dari `npx supabase start` (lokal) atau dashboard project (cloud)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
# Hanya untuk server-side / Edge Functions. JANGAN taruh di client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Midtrans (sandbox) ---
# Daftar gratis di https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
MIDTRANS_IS_PRODUCTION=false

# --- Firebase Cloud Messaging (opsional untuk push) ---
# Service account JSON key untuk kirim push dari Edge Function
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
